<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DirectXfer.WindowsLauncher</RootNamespace>
    <AssemblyName>Direct-Xfer</AssemblyName>
    <AssemblyTitle>Direct-Xfer</AssemblyTitle>
    <Description>Direct-Xfer Windows launcher</Description>
    <Company>Direct-Xfer</Company>
    <Product>Direct-Xfer</Product>
    <Copyright>Copyright © Direct-Xfer 2026</Copyright>
    <Version>1.69.3</Version>
    <AssemblyVersion>1.69.3.0</AssemblyVersion>
    <FileVersion>1.69.3.0</FileVersion>
    <InformationalVersion>1.69.3</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <AppHostDotNetSearch>AppRelative</AppHostDotNetSearch>
    <AppHostRelativeDotNet>runtime\dotnet</AppHostRelativeDotNet>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>direct-xfer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>
</Project>
