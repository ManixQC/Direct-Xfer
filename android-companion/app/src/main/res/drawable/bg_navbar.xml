<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation surface: panel colour with a 1dp top border, like the PWA nav. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dx_border" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/dx_panel" />
        </shape>
    </item>
</layer-list>
