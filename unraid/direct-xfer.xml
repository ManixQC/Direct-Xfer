<?xml version="1.0"?>
<Container version="2">
  <Name>Direct-Xfer</Name>
  <Repository>manixqc/direct-xfer:latest</Repository>
  <Registry>https://hub.docker.com/r/manixqc/direct-xfer</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <WebUI>http://[IP]:[PORT:55750]/</WebUI>
  <Icon>https://raw.githubusercontent.com/ManixQC/Direct-Xfer/main/unraid/direct-xfer.png</Icon>
  <Support>https://github.com/ManixQC/Direct-Xfer</Support>
  <Project>https://github.com/ManixQC/Direct-Xfer</Project>
  <Overview>Direct-Xfer — direct file sharing, reception, collaboration, image hosting and installable PWA.</Overview>
  <Category>Network:Other Productivity: Tools:</Category>
  <Config Name="Web UI" Target="55750" Default="55750" Mode="tcp" Description="Direct-Xfer HTTP/HTTPS port" Type="Port" Display="always" Required="true" Mask="false">55750</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/direct-xfer" Mode="rw" Description="Persistent settings and metadata" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/direct-xfer</Config>
  <Config Name="Images" Target="/Images" Default="" Mode="rw" Description="Image hosting storage" Type="Path" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Received files" Target="/Direct-Xfer" Default="" Mode="rw" Description="Reception/import destination" Type="Path" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Host root" Target="/host" Default="/" Mode="ro" Description="Host files exposed read-only to the picker" Type="Path" Display="advanced" Required="true" Mask="false">/</Config>
  <Config Name="PUID" Target="PUID" Default="99" Description="Runtime user id" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Description="Runtime group id" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
</Container>
