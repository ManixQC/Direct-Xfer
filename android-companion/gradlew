#!/bin/sh
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
URL="https://raw.githubusercontent.com/gradle/gradle/v8.13.0/gradle/wrapper/gradle-wrapper.jar"
EXPECTED="81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f"

verify_jar() {
  if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$JAR" | awk '{print $1}')
  elif command -v shasum >/dev/null 2>&1; then
    actual=$(shasum -a 256 "$JAR" | awk '{print $1}')
  else
    echo "sha256sum ou shasum est requis pour vérifier Gradle." >&2
    return 1
  fi
  [ "$actual" = "$EXPECTED" ] || {
    echo "Échec de vérification du gradle-wrapper.jar ($actual)." >&2
    rm -f "$JAR"
    return 1
  }
}

if [ ! -f "$JAR" ]; then
  mkdir -p "$(dirname "$JAR")"
  echo "Téléchargement du Gradle Wrapper 8.13…"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 --connect-timeout 20 "$URL" -o "$JAR"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$JAR" "$URL"
  else
    echo "curl ou wget est requis pour initialiser Gradle." >&2
    exit 1
  fi
fi
verify_jar
exec java ${JAVA_OPTS:-} ${GRADLE_OPTS:-} -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
