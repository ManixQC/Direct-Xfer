    "test:historical": "node --test test-historical/*.test.js"
  },
  "engines": {
    "node": "20 || >=22"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^4.19.2",
    "node-forge": "^1.3.1",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "license": "MIT"
}
